{% extends "flights/base.jinja" %}

{% block title %}Регистрация пассажиров{% endblock %}

{% block content %}

<section class="page-heading">
    <div>
        <p class="eyebrow">Панель сотрудника</p>
        <h1>Регистрация пассажиров</h1>
        <p class="subtitle">
            Проверка бронирований и оформление регистрации на рейс.
        </p>
    </div>
</section>

<section class="panel">
    <form method="get" class="checkin-search">
        <div class="checkin-search-field">
            <label for="reservation-search">
                Найти бронирование
            </label>

            <input
                id="reservation-search"
                type="search"
                name="q"
                value="{{ query }}"
                maxlength="100"
                placeholder="Номер рейса, логин, имя или номер билета"
            >
        </div>

        <button class="primary-action" type="submit">
            Найти
        </button>

        {% if query %}
            <a href="{{ url('flights:check_in_list') }}">
                Сбросить
            </a>
        {% endif %}
    </form>
</section>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Бронирования</h2>
            <p>Регистрация пассажиров через интерфейс сотрудника</p>
        </div>
    </div>

    <div class="table-scroll">
        <table class="flights-table">
            <thead>
                <tr>
                    <th>Рейс</th>
                    <th>Пассажир</th>
                    <th>Место</th>
                    <th>Отправление</th>
                    <th>Статус</th>
                    <th>Номер билета</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                {% for reservation in reservations %}
                    <tr>
                        <td>
                            <a
                                href="{{ url('flights:flight_detail', pk=reservation.flight.pk) }}"
                            >
                                {{ reservation.flight.flight_number }}
                            </a>
                        </td>

                        <td>
                            <strong>{{ reservation.user.username }}</strong>
                        </td>

                        <td>{{ reservation.seat_number }}</td>

                        <td>
                            {{ datetime_local(reservation.flight.departure_time) }}
                        </td>

                        <td>
                            {% if reservation.is_checked_in %}
                                <span class="status status-arrival">
                                    Зарегистрирован
                                </span>
                            {% elif reservation.flight.departure_time <= now %}
                                <span class="status status-past">
                                    Рейс отправился
                                </span>
                            {% else %}
                                <span class="status status-departure">
                                    Ожидает регистрации
                                </span>
                            {% endif %}
                        </td>

                        <td>
                            {{ reservation.ticket_number or "—" }}
                        </td>

                        <td>
                            {% if reservation.is_checked_in %}
                                <span class="muted-text">
                                    Завершено
                                </span>
                            {% elif reservation.flight.departure_time <= now %}
                                <span class="muted-text">
                                    Недоступно
                                </span>
                            {% else %}
                                <a
                                    class="details-link"
                                    href="{{ url('flights:check_in_detail', pk=reservation.pk) }}"
                                >
                                    Зарегистрировать →
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="empty-state">
                            Бронирований по заданному запросу нет.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>

{% endblock %}